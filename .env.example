# ── Fortnox OAuth app credentials ─────────────────────────────
# Create an app at https://developer.fortnox.se (Developer Portal)
# and register the redirect URI below on the app.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=http://localhost:8000/auth/callback

# Space-separated scopes requested during OAuth (must be enabled on your Fortnox app)
FORTNOX_SCOPES=companyinformation invoice bookkeeping payment customer supplierinvoice currency profile assets

# ── App settings ──────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Try the app without a Fortnox account: seed the demo company first
# (cd backend && python -m scripts.seed_demo), then set DEMO_MODE=1.
# Demo data lives in backend/data-demo/ — a real mirror is never touched.
DEMO_MODE=0

# ── AI assistant (F8) — see docs/AI_DESIGN.md ─────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id; switch freely between sessions
AI_MODEL=anthropic/claude-opus-4.8
# Model for the verify_draft auditor pass (F9). Blank = same as AI_MODEL;
# set a cheaper model here to lower the cost of verification.
AI_VERIFIER_MODEL=
# Web research for Swedish tax rules — key from https://tavily.com (free tier)
TAVILY_API_KEY=
# Comma-separated allowlist for web_search/fetch_page (default: authoritative Swedish sources)
AI_SEARCH_DOMAINS=skatteverket.se,www4.skatteverket.se,riksgalden.se,regeringen.se,bolagsverket.se,riksdagen.se,lagen.nu,bfn.se,verksamt.se,scb.se